@model SPMS.Models.Student
@{ ViewData["Title"] = "Student Details"; }
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="fw-bold">Student Details</h1><p class="text-muted">Registration #@Model.Id</p></div><div><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a> <a asp-action="Index" class="btn btn-outline-secondary">Back</a></div></div>
<div class="card shadow-sm border-0"><div class="card-body p-4"><div class="row g-4">
<div class="col-md-6"><small class="text-muted">Full Name</small><div class="fs-5 fw-semibold">@Model.FirstName @Model.LastName</div></div>
<div class="col-md-6"><small class="text-muted">Email</small><div class="fs-5">@Model.Email</div></div>
<div class="col-md-4"><small class="text-muted">Mobile</small><div>@Model.Mobile</div></div><div class="col-md-4"><small class="text-muted">Date of Birth</small><div>@Model.DateOfBirth.ToString("dd MMM yyyy")</div></div><div class="col-md-4"><small class="text-muted">Gender</small><div>@Model.Gender</div></div>
<div class="col-md-6"><small class="text-muted">Course</small><div>@Model.Course</div></div><div class="col-md-6"><small class="text-muted">Registration Date</small><div>@Model.RegistrationDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</div></div>
<div class="col-12"><small class="text-muted">Address</small><div>@Model.Address, @Model.City, @Model.State - @Model.Pincode</div></div>
<div class="col-12"><small class="text-muted">Status</small><div><span class="badge @(Model.IsActive ? "text-bg-success" : "text-bg-secondary")">@(Model.IsActive ? "Active" : "Inactive")</span></div></div>
</div></div></div></div>
