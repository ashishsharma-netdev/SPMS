@model IEnumerable<SPMS.Models.Student>
@{
    ViewData["Title"] = "Students";
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h1 class="fw-bold mb-1">Students</h1><p class="text-muted mb-0">Manage student registrations</p></div>
        <a asp-action="Create" class="btn btn-primary">+ Register Student</a>
    </div>
    @if (TempData["Success"] is string message) { <div class="alert alert-success">@message</div> }
    <form method="get" class="row g-2 mb-3">
        <div class="col-md-10"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name, email or course..." /></div>
        <div class="col-md-2 d-grid"><button class="btn btn-outline-primary">Search</button></div>
    </form>
    <div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Name</th><th>Email</th><th>Mobile</th><th>Course</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
        @foreach (var s in Model) { <tr>
            <td class="fw-semibold">@s.FirstName @s.LastName</td><td>@s.Email</td><td>@s.Mobile</td><td>@s.Course</td>
            <td><span class="badge @(s.IsActive ? "text-bg-success" : "text-bg-secondary")">@(s.IsActive ? "Active" : "Inactive")</span></td>
            <td class="text-end"><a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">View</a> <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this student?');"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td>
        </tr> }
        @if (!Model.Any()) { <tr><td colspan="6" class="text-center py-5 text-muted">No students found.</td></tr> }
        </tbody></table></div></div>
</div>
